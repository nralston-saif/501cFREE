# Copy to .env.local (development) or set in your host's environment
# (production). NEXT_PUBLIC_* values are baked in at build time: rebuild
# after changing them.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Off (or unset) = open-access DEMO MODE: in-memory sample data, no login.
# Set to true, with the Supabase values below, to run against your database.
NEXT_PUBLIC_USE_SUPABASE=true

# Your Supabase project (Project Settings -> API Keys: the publishable and
# secret keys, not the legacy anon/service_role keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Used for storage writes, public intake endpoints, cron jobs
# and team invites. Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# The app's public origin: scheme + host, no trailing slash, WITHOUT the base
# path. Required in production; auth emails (invites, password resets) and
# the QuickBooks OAuth callback are built from it. Used by
# scripts/bootstrap-admin.mjs too.
NEXT_PUBLIC_SITE_URL=https://office.example.org

# ---------------------------------------------------------------------------
# Optional: branding and hosting
# ---------------------------------------------------------------------------

# Product name in the browser tab, header and login screen (default
# "501(c)(FREE)"). Your organization's own name, used in letters and emails,
# is set in the app under Settings.
NEXT_PUBLIC_APP_NAME=501(c)(FREE)

# Serve the app under a sub-path, e.g. /office (leading slash, no trailing
# slash). Default: the domain root. If you set it, also prefix the cron
# paths in vercel.json (e.g. /office/api/cron/qbo-pull) and any redirect
# URIs you register with Intuit.
NEXT_PUBLIC_BASE_PATH=

# Secret for the scheduled jobs in vercel.json (/api/cron/stock-prices,
# /api/cron/qbo-pull). Vercel Cron sends it as `Authorization: Bearer
# <CRON_SECRET>`; other schedulers must do the same. openssl rand -hex 32
CRON_SECRET=your-cron-secret

# ---------------------------------------------------------------------------
# Optional integrations (each feature turns itself off when unset)
# ---------------------------------------------------------------------------

# Claude API key: invoice field extraction, notes-inbox filing, grant and PRI
# research memos, decline-email drafts. Server-only.
ANTHROPIC_API_KEY=sk-ant-...

# Resend: emails acknowledgement letters and ticket-assignment notices.
RESEND_API_KEY=re_xxxxxxxx
# Fallback sender when Settings -> Acknowledgement letters has no from-address
LETTER_FROM_EMAIL=letters@example.org

# Financial Modeling Prep: market prices for valuing stock contributions.
FMP_API_KEY=your-financial-modeling-prep-key

# Liveblocks: real-time co-editing of meeting notes. Without it, meetings are
# edited as plain text.
LIVEBLOCKS_SECRET_KEY=sk_your-liveblocks-secret
# Only needed when several installations share one Liveblocks project:
# prefixes room ids so they never collide (letters, digits, - and _).
NEXT_PUBLIC_LIVEBLOCKS_ROOM_PREFIX=

# Public donate-form ingestion (POST /api/public/donation-inquiry). Your
# website forwards each submission server-to-server with this value in the
# `x-inquiry-secret` header. openssl rand -hex 32
DONATION_INQUIRY_INGEST_SECRET=your-inquiry-ingest-secret

# Public grant-proposal ingestion (POST /api/public/grant-proposal; the body
# contract is documented in app/api/public/grant-proposal/route.ts). Sent in
# the `x-proposal-secret` header. openssl rand -hex 32
GRANT_PROPOSAL_INGEST_SECRET=your-proposal-ingest-secret

# QuickBooks Online sync (create an app at developer.intuit.com). Use
# development keys + sandbox while testing, production keys + production
# for your real company.
QBO_CLIENT_ID=your-intuit-client-id
QBO_CLIENT_SECRET=your-intuit-client-secret
QBO_ENVIRONMENT=sandbox
# Overrides the computed <NEXT_PUBLIC_SITE_URL><base path>/api/quickbooks/callback;
# must exactly match a redirect URI registered with Intuit.
# QBO_REDIRECT_URI=https://office.example.org/api/quickbooks/callback
